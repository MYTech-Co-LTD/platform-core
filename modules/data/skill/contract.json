{
  "version": 1,
  "tools": [
    {
      "id": "guide",
      "group": "guide",
      "title": "数据工作流指南",
      "analyst": true,
      "requiredScope": "data:read",
      "mutating": false,
      "annotations": {
        "readOnlyHint": true
      },
      "channels": {
        "mcp": {
          "name": "data_agent_guide",
          "description": "返回数据问数工作流（七步）与硬约束（主体钉死/新鲜度脚注/截断语义），以及今天的日期。开始任何数据任务前先调它。",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "harness_catalog",
      "group": "guide",
      "title": "工具清单",
      "analyst": true,
      "requiredScope": "data:read",
      "mutating": false,
      "annotations": {
        "readOnlyHint": true
      },
      "channels": {
        "mcp": {
          "name": "data_harness_catalog",
          "description": "列出本面全部工具（分组/scope/是否写）。与注册表逐条一致。",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "search",
      "group": "discovery",
      "title": "搜索目录",
      "analyst": true,
      "requiredScope": "data:read",
      "mutating": false,
      "annotations": {
        "readOnlyHint": true
      },
      "channels": {
        "mcp": {
          "name": "search_catalog",
          "description": "按关键词搜索可见指标（或数据集）。搜指标时同义词也命中；数据集只按名称匹配。返回 id/标题/档位/归属/一句话说明，≤20 条。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string",
                "description": "关键词（id/标题/说明/同义词的子串，大小写不敏感）"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "metric",
                  "dataset"
                ],
                "description": "缺省 = metric"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "certified",
                  "custom"
                ],
                "description": "certified=平台口径(l1)，custom=本租户口径(l2)"
              }
            },
            "required": []
          },
          "outputSchema": {
            "type": "object"
          }
        },
        "openclaw": {
          "name": "search_catalog",
          "description": "按关键词搜索当前用户可见的指标（**同义词也命中**）。问数第一步用它：用户说「营业额/销售金额/外部批发」这类业务词，先搜索拿到候选 id，再 describe_metric 看口径——**不要凭记忆猜指标 id**。0 命中时换 1~2 个同义词再搜。返回 id/标题/档位/归属/一句话说明（≤20 条）。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string",
                "description": "关键词（id/标题/说明/同义词的子串，大小写不敏感）"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "metric",
                  "dataset"
                ],
                "description": "缺省 = metric"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "certified",
                  "custom"
                ],
                "description": "可选：按可信度过滤"
              }
            },
            "required": [
              "q"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "describe_metric",
      "group": "discovery",
      "title": "指标详情",
      "analyst": true,
      "requiredScope": "data:read",
      "mutating": false,
      "annotations": {
        "readOnlyHint": true
      },
      "channels": {
        "mcp": {
          "name": "describe_metric",
          "description": "按 id 取指标详情：口径定义/粒度维度/参数/实体与同义词/归属/档位/版本/新鲜度。查数前必调（拿参数键名与维度）。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "指标 id（取自 search_catalog 或 list）"
              },
              "coverage": {
                "type": "boolean",
                "description": "包含数据覆盖区间 {minBizday,maxBizday}（按需；问「最早/到几号」时传 true）"
              }
            },
            "required": [
              "id"
            ]
          },
          "outputSchema": {
            "type": "object"
          }
        },
        "openclaw": {
          "name": "describe_metric",
          "description": "按 id 取指标详情：口径定义/粒度维度/参数/归属/档位/版本/新鲜度。args 键或维度名拿不准时先调它（id 取自 list_metrics）；sample_dimension_values 的 dimension 必须是这里 grain 里的一员。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "指标 id（来自 search_catalog / list_metrics）"
              },
              "coverage": {
                "type": "boolean",
                "description": "包含数据覆盖区间 {minBizday,maxBizday}；问「最早的数据/到几号」时传 true"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "describe_dataset",
      "group": "discovery",
      "title": "数据集详情",
      "analyst": true,
      "requiredScope": "data:read",
      "mutating": false,
      "annotations": {
        "readOnlyHint": true
      },
      "channels": {
        "mcp": {
          "name": "describe_dataset",
          "description": "按 `schema.table` 取数据集的列/类型/归属/新鲜度。只见平台暴露的关系。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "dataset": {
                "type": "string",
                "description": "关系名（如 marts.fct_retail_sale）"
              }
            },
            "required": [
              "dataset"
            ]
          },
          "outputSchema": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "sample_dimension_values",
      "group": "discovery",
      "title": "维度值抽样",
      "analyst": true,
      "requiredScope": "data:query",
      "mutating": false,
      "annotations": {
        "readOnlyHint": true
      },
      "channels": {
        "mcp": {
          "name": "sample_dimension_values",
          "description": "取某指标某维度的取值与频次（≤50 行），用于确认过滤值的确切写法（如门店名）。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "metricId": {
                "type": "string"
              },
              "dimension": {
                "type": "string",
                "description": "维度名（须是该指标粒度维度之一）"
              },
              "q": {
                "type": "string",
                "description": "子串过滤（LIKE 包裹，转义通配）"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50,
                "description": "缺省 50"
              }
            },
            "required": [
              "metricId",
              "dimension"
            ]
          },
          "outputSchema": {
            "type": "object"
          }
        },
        "openclaw": {
          "name": "sample_dimension_values",
          "description": "取某指标某维度的取值与频次（≤50 行），用于确认过滤值/分组维度的确切写法（如门店名）。dimension 必须是该指标粒度维度之一（describe_metric 返回的 grain）；回包 truncated=true 时只说明「值太多被截断」，不是数据错误。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "metricId": {
                "type": "string",
                "description": "指标 id"
              },
              "dimension": {
                "type": "string",
                "description": "维度名（grain 之一）"
              },
              "q": {
                "type": "string",
                "description": "子串过滤（可选）"
              },
              "limit": {
                "type": "number",
                "description": "1–50，缺省 50"
              }
            },
            "required": [
              "metricId",
              "dimension"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "preview_query",
      "group": "query",
      "title": "预览查询计划",
      "analyst": true,
      "requiredScope": "data:query",
      "mutating": false,
      "annotations": {
        "readOnlyHint": true
      },
      "channels": {
        "mcp": {
          "name": "preview_query",
          "description": "按指标+切片参数生成将执行的 SQL 与行数上限——只编译不执行（0 次仓库查询）。核对口径/过滤用。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "metricId": {
                "type": "string"
              },
              "args": {
                "type": "object",
                "description": "指标声明参数（键名以 describe_metric 为准）"
              },
              "slicing": {
                "type": "object",
                "description": "{dimensions?,filters?,orderBy?,limit?,total?}"
              }
            },
            "required": [
              "metricId"
            ]
          },
          "outputSchema": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "query",
      "group": "query",
      "title": "受治理查询",
      "analyst": true,
      "requiredScope": "data:query",
      "mutating": false,
      "annotations": {
        "readOnlyHint": true
      },
      "channels": {
        "mcp": {
          "name": "query_metric",
          "description": "按指标 id 查数，回完整信任信封（口径版本/主体/数据截止/行集/审计 id）。主体由平台钉死；切片维度超出粒度即拒；行上限 1000。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "metricId": {
                "type": "string"
              },
              "args": {
                "type": "object"
              },
              "dimensions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "聚合维度（⊆ 指标粒度；缺省 = 粒度明细）"
              },
              "filters": {
                "type": "object",
                "description": "已声明参数或维度的等值/IN 过滤"
              },
              "orderBy": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string"
                    },
                    "dir": {
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ]
                    }
                  },
                  "required": [
                    "column"
                  ]
                }
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "total": {
                "type": "boolean",
                "description": "切片时显式 true 才回 total（部分合计≠全局合计）"
              }
            },
            "required": [
              "metricId"
            ]
          },
          "outputSchema": {
            "type": "object"
          }
        },
        "openclaw": {
          "name": "query_data",
          "description": "按指标查数：metricId 来自 list_metrics；args 的**键**只能取该指标 params[].name（乐檬指标就是 `bizday`），**形状**由该 params 的 type 决定：type=date_range ⇒ 值传对象 {\"from\":\"YYYY-MM-DD\",\"to\":\"YYYY-MM-DD\"}（闭区间，查单日则 from=to）；type=string/number/date ⇒ 值传单值（日期单值一律 YYYY-MM-DD）。⚠️ **`date_range` 是类型名、不是键名**——传 {\"date_range\":{…}} 会被服务端 400 `unknown_param:date_range`；正确写法是 {\"bizday\":{\"from\":…,\"to\":…}}。求和类（可加）指标的回包自带 total 字段=该过滤范围的合计——直接引用该值，不要自己把明细行加总；没有 total 字段（比率/去重计数类指标）就不要跨行求和（跨行求和是错数）。「只要总数」可传 args.total=true（必须布尔）——服务端求和恒返回单行合计；区间超过 4 天优先拆单日或用 total，不要裸拉明细。参数键与形状以 list_metrics 返回的 params 为准，不要臆造。回包带 subject（本次钉死的数据主体）与 columns/rows；truncated=true 表示截断——只能答「数据不全」，收窄范围或改传 args.total=true 重查，不要把截断结果当全量。新鲜度与口径射程由系统自动附加：消息末尾会固定附上服务端算好的 📅 新鲜度行与 📐 口径行（该指标声明了射程时才有）——不要自己写任何 📅 / 📐 行，也不要复述或拼接 freshness_line / scope_line（自己写了也会被系统剥掉再统一附加）。**当答案涉及门店/对象个数时，口径行里的排除项是结论的一部分**：不要只报「5 家」，要让读者看得到分母与排除了什么。data_as_of（数据截止，已是北京时间 UTC+8，直接引用不要自行换算）可注明「数据截至 X」；没有该字段=新鲜度未知，如实说明，不要编；明细 rows 按 bizday 降序，首行即最新分区；当日数据是部分天，须标注。**Top-N / 分组**（如「按供应商前 5」）：传 dimensions:[维度名]（必须是该指标 grain 的子集）+ orderBy:[{column:\"value\",dir:\"desc\"}] + limit:5，一次拿到结果，不要拉全量行自己排序。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "metricId": {
                "type": "string",
                "description": "指标 id（来自 list_metrics）"
              },
              "args": {
                "type": "object",
                "description": "指标参数键值对；**键** = list_metrics 返回的 params[].name（乐檬指标是 `bizday`），**值形状**由 type 定（type=date_range 传 {from,to} 对象，其余传单值）。⚠️ `date_range` 是类型名不是键名，写成键会 400 unknown_param:date_range；「只要总数」加 total:true（布尔，非真值一律被拒）",
                "additionalProperties": true
              },
              "dimensions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "按这些维度聚合（必须是该指标 grain 的子集，如 [\"supplier_num\"]）。Top-N / 分组看数用它"
              },
              "orderBy": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string"
                    },
                    "dir": {
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ]
                    }
                  },
                  "required": [
                    "column"
                  ],
                  "additionalProperties": false
                },
                "description": "排序；Top-N 用 [{column:\"value\",dir:\"desc\"}]（配合 limit）"
              },
              "limit": {
                "type": "number",
                "description": "返回行数上限（Top-N 用，如 5）"
              }
            },
            "required": [
              "metricId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "explore_query",
      "group": "query",
      "title": "受约束探索查询",
      "analyst": true,
      "requiredScope": "data:query",
      "mutating": false,
      "annotations": {
        "readOnlyHint": true
      },
      "channels": {
        "mcp": {
          "name": "explore_query",
          "description": "对 marts 做结构化聚合（**不收 SQL 文本**）：relation + joins + measures + dimensions + filters + limit。org 由平台钉死；列必须真实存在；被掩码的列/整表拒用；行上限 1000。跨对象问题先 joins 声明语义关系（见 relations.yml），再用 `<关系名>.<列>` 引用被 join 表的列；join 是内连接（空键/未匹配行不计）。用于「为什么/构成/对比」类分析；要拿已认证口径的数字仍用 query_metric。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "relation": {
                "type": "string",
                "description": "marts 模型名（如 fct_retail_sale）"
              },
              "joins": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "语义关系名（relations.yml，≤5）；只有 verified 且命中率 ≥0.95 的关系可用"
              },
              "measures": {
                "type": "array",
                "description": "聚合列（1–10 项）",
                "items": {
                  "type": "object",
                  "properties": {
                    "agg": {
                      "type": "string",
                      "enum": [
                        "sum",
                        "avg",
                        "min",
                        "max",
                        "count",
                        "count_distinct"
                      ]
                    },
                    "column": {
                      "type": "string"
                    },
                    "as": {
                      "type": "string",
                      "description": "别名（缺省 <agg>_<column>）"
                    }
                  },
                  "required": [
                    "agg",
                    "column"
                  ]
                }
              },
              "dimensions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "分组维度（≤4）"
              },
              "filters": {
                "type": "array",
                "description": "过滤（≤10 项）；op ∈ eq/neq/in/gte/lte/between",
                "items": {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string"
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "eq",
                        "neq",
                        "in",
                        "gte",
                        "lte",
                        "between"
                      ]
                    },
                    "value": {}
                  },
                  "required": [
                    "column",
                    "op",
                    "value"
                  ]
                }
              },
              "orderBy": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "desc": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "description": "缺省 200"
              }
            },
            "required": [
              "relation",
              "measures"
            ]
          },
          "outputSchema": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "explore_recipe",
      "group": "query",
      "title": "分析配方",
      "analyst": true,
      "requiredScope": "data:query",
      "mutating": false,
      "annotations": {
        "readOnlyHint": true
      },
      "channels": {
        "mcp": {
          "name": "explore_recipe",
          "description": "三个写死口径的分析配方：variance（两期方差分解）/ top_contributors（Top-N 贡献）/ baseline（基线异常，中位数+MAD，|score|≥3.5）。只支持单列聚合指标（复合口径请用 explore_query）。结果带证据包（SQL/口径/数据截至）。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "recipe": {
                "type": "string",
                "enum": [
                  "variance",
                  "top_contributors",
                  "baseline"
                ]
              },
              "metricId": {
                "type": "string"
              },
              "dimension": {
                "type": "string",
                "description": "分组维度（列名）"
              },
              "periodA": {
                "type": "object",
                "description": "variance 本期 {from,to}"
              },
              "periodB": {
                "type": "object",
                "description": "variance 基期 {from,to}"
              },
              "period": {
                "type": "object",
                "description": "top_contributors 窗口 {from,to}"
              },
              "asOf": {
                "type": "string",
                "description": "baseline 观测日 YYYY-MM-DD"
              },
              "topN": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50,
                "description": "缺省 10"
              },
              "baselineWindowDays": {
                "type": "integer",
                "minimum": 7,
                "maximum": 180,
                "description": "缺省 28"
              }
            },
            "required": [
              "recipe",
              "metricId",
              "dimension"
            ]
          },
          "outputSchema": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "freshness",
      "group": "health",
      "title": "新鲜度",
      "analyst": true,
      "requiredScope": "data:read",
      "mutating": false,
      "annotations": {
        "readOnlyHint": true
      },
      "channels": {
        "mcp": {
          "name": "get_freshness",
          "description": "数据截止日/物化时刻/滞后秒。scope=指标 id 时回该指标链路水位与状态；缺省回全局水位。判据与发布面对齐表同源。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "description": "指标 id（缺省 = 全局）"
              }
            },
            "required": []
          },
          "outputSchema": {
            "type": "object"
          }
        },
        "openclaw": {
          "name": "get_freshness",
          "description": "数据截止日/物化时刻/滞后秒。scope=指标 id 查该指标链路水位；缺省查全局水位。用户问「数据到几号/新不新」用它，不要靠猜。回 status=unknown 如实说「新鲜度未知」，不要编。",
          "inputSchema": {
            "type": "object",
