{
  "id": "lemeng.loss.adjustment.l0",
  "domain": "lemeng",
  "accounts": [
    "3120",
    "64188"
  ],
  "identityGate": true,
  "source": {
    "connectionRef": "lemeng",
    "url": "https://cloud.nhsoft.cn/agi/api/nhsoft.ama.ai.adjustment.order.find",
    "method": "POST",
    "body": "{\"date_start\":\"${date-1d}\",\"date_end\":\"${date-1d}\",\"date_type\":\"制单时间\",\"page_number\":1,\"page_size\":100}",
    "responsePath": "/result",
    "retryAttempts": 3,
    "retryBackoffMs": 2000,
    "schema": [
      {
        "name": "adjustment_order_fid",
        "type": "string"
      },
      {
        "name": "order_type",
        "type": "string"
      },
      {
        "name": "branch_num",
        "type": "int64"
      },
      {
        "name": "business_date",
        "type": "string"
      },
      {
        "name": "state_code",
        "type": "int64"
      },
      {
        "name": "state_name",
        "type": "string"
      },
      {
        "name": "total_money",
        "type": "decimal"
      },
      {
        "name": "operator",
        "type": "string"
      },
      {
        "name": "memo",
        "type": "string"
      },
      {
        "name": "department",
        "type": "string"
      },
      {
        "name": "creator",
        "type": "string"
      },
      {
        "name": "create_time",
        "type": "string"
      },
      {
        "name": "auditor",
        "type": "string"
      },
      {
        "name": "audit_time",
        "type": "string"
      },
      {
        "name": "storehouse_num",
        "type": "int64"
      },
      {
        "name": "direction",
        "type": "string"
      },
      {
        "name": "cause",
        "type": "string"
      },
      {
        "name": "cause_code",
        "type": "string"
      },
      {
        "name": "related_order_no",
        "type": "string"
      }
    ],
    "pagination": {
      "type": "static_pages",
      "pages": 9,
      "pageParam": "page_number",
      "pageSizeParam": "page_size",
      "pageSize": 100,
      "truncationGuard": true
    }
  },
  "transform": {
    "sql": "SELECT\n  'adj-' || '${ENV:SYSTEM_BOOK}' || '-loss_adjustment-' || replace(replace('${datetime}','-',''),'_','T') || 'Z' AS batch_id,\n  '${ENV:SYSTEM_BOOK}' AS system_book,\n  CAST('${date-1d}' AS DATE) AS bizday,\n  CAST(o.adjustment_order_fid AS VARCHAR) AS order_no,\n  CAST(o.order_type AS VARCHAR) AS order_type,\n  CAST(o.branch_num AS INTEGER) AS branch_num,\n  CAST(o.business_date AS VARCHAR) AS business_date,\n  CAST(o.state_code AS INTEGER) AS state_code,\n  CAST(o.state_name AS VARCHAR) AS state_name,\n  CAST(o.total_money AS DECIMAL(14,2)) AS total_money,\n  CAST(o.operator AS VARCHAR) AS operator,\n  CAST(o.memo AS VARCHAR) AS memo,\n  CAST(o.department AS VARCHAR) AS department,\n  CAST(o.creator AS VARCHAR) AS creator,\n  CAST(o.create_time AS VARCHAR) AS create_time,\n  CAST(o.auditor AS VARCHAR) AS auditor,\n  CAST(o.audit_time AS VARCHAR) AS audit_time,\n  CAST(o.storehouse_num AS BIGINT) AS storehouse_num,\n  CAST(o.direction AS VARCHAR) AS direction,\n  CAST(o.cause AS VARCHAR) AS cause,\n  CAST(o.cause_code AS VARCHAR) AS cause_code,\n  CAST(NULL AS VARCHAR) AS related_order_no\nFROM input o"
  },
  "gate": {
    "rules": {
      "batch_id": "not_null",
      "system_book": "not_null",
      "bizday": "not_null",
      "order_no": "not_null",
      "branch_num": "not_null",
      "cause": "not_null"
    }
  },
  "sink": {
    "type": "minio",
    "connectionRef": "zos",
    "bucket": "shanhai-data",
    "key": "lemeng/loss_adjustment/system_book=${ENV:SYSTEM_BOOK}/bizday=${date-1d}/chunk=all.parquet",
    "format": "parquet",
    "mode": "overwrite",
    "compression": "zstd"
  }
}
