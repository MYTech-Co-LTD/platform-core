        "x": 0,
        "y": 0
      },
      "data": {
        "label": "w0",
        "componentId": "src.rest",
        "schema": [
          {
            "name": "x",
            "type": "string"
          }
        ],
        "properties": {
          "connectionRef": "lemeng",
          "url": "https://cloud.nhsoft.cn/agi/mcp",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
          },
          "body": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"whoami\", \"arguments\": {}}}",
          "paginationType": "none",
          "responseFormat": "xml",
          "rawResponseDestination": "/workspace/.duckle-raw/whoami-${datetime}.sse",
          "retryAttempts": 3,
          "retryBackoffMs": 2000
        }
      }
    },
    {
      "id": "g0",
      "type": "transform",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "g0",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT unnest(regexp_extract_all(content, '(?m)^data: ([^\\r\\n]*)', 1)) AS line FROM read_text('/workspace/.duckle-raw/whoami-${datetime}.sse')"
        }
      }
    },
    {
      "id": "g1",
      "type": "transform",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "g1",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT json_extract_string(line, '$.result.content[0].text') AS txt FROM input QUALIFY row_number() OVER () = count(*) OVER ()"
        }
      }
    },
    {
      "id": "g2",
      "type": "transform",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "g2",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT json_extract_string(txt, '$.company_id') AS company_id, json_extract_string(txt, '$.branch_nums') AS branch_nums FROM input"
        }
      }
    },
    {
      "id": "d0",
      "type": "transform",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "d0",
        "componentId": "ctl.die",
        "properties": {
          "condition": "no-rows",
          "message": "identity: whoami 响应里没有可解析的身份（网关形状变了？）⇒ 身份未证，拒绝采集与写湖"
        }
      }
    },
    {
      "id": "g3",
      "type": "transform",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "g3",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT 'book' AS violation, company_id AS detail FROM input WHERE company_id IS DISTINCT FROM '${ENV:SYSTEM_BOOK}' UNION ALL SELECT 'branch' AS violation, CAST(c.branch_num AS VARCHAR) AS detail FROM (SELECT unnest('${ENV:BRANCH_NUMS}'::BIGINT[]) AS branch_num) c LEFT JOIN (SELECT unnest(CAST(json_extract(branch_nums, '$[*]') AS BIGINT[])) AS branch_num FROM input) w USING (branch_num) WHERE w.branch_num IS NULL"
        }
      }
    },
    {
      "id": "d1",
      "type": "transform",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "d1",
        "componentId": "ctl.die",
        "properties": {
          "condition": "has-rows",
          "message": "identity: 凭据账套/门店清单自证未过 ⇒ 拒绝采集与写湖"
        }
      }
    },
    {
      "id": "gv",
      "type": "transform",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "gv",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT 'BRANCH_NUMS' AS violation, '${ENV:BRANCH_NUMS}' AS detail, 'JSON integer array, e.g. [1001,1002]' AS rule WHERE NOT regexp_full_match('${ENV:BRANCH_NUMS}', '\\[[0-9]+([, ]+[0-9]+)*\\]') UNION ALL SELECT 'SYSTEM_BOOK', '${ENV:SYSTEM_BOOK}', 'digits only' WHERE NOT regexp_full_match('${ENV:SYSTEM_BOOK}', '[0-9]{1,32}') UNION ALL SELECT 'BIZDAY', '${BIZDAY}', 'YYYY-MM-DD' WHERE NOT regexp_full_match('${BIZDAY}', '[0-9]{4}-[0-9]{2}-[0-9]{2}') UNION ALL SELECT 'BATCH_ID', 'iv-' || '${ENV:SYSTEM_BOOK}' || '-inventory_snapshot-' || replace(replace('${datetime}','-',''),'_','T') || 'Z' AS v, 'iv-<book>-inventory_snapshot-YYYYMMDDTHHMMSSZ' WHERE NOT regexp_full_match('iv-' || '${ENV:SYSTEM_BOOK}' || '-inventory_snapshot-' || replace(replace('${datetime}','-',''),'_','T') || 'Z', 'iv-[0-9]+-inventory_snapshot-[0-9]{8}T[0-9]{6}Z')"
        }
      }
    },
    {
      "id": "dv",
      "type": "transform",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "dv",
        "componentId": "ctl.die",
        "properties": {
          "condition": "has-rows",
          "message": "EXPECTED_VALUE_MISSING_OR_MALFORMED: 期望值缺席或形状非法（{rows} 条违规，明细见上）⇒ 拒绝采集与写湖。处置：检查该管线调度/触发面的 env 注入"
        }
      }
    },
    {
      "id": "shape",
      "type": "transform",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "label": "shape",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT\n  CAST(batch_id AS VARCHAR) AS batch_id,\n  CAST(system_book AS INTEGER) AS system_book,\n  CAST(bizday AS DATE) AS bizday,\n  CAST(movement_id AS VARCHAR) AS movement_id,\n  CAST(branch_num AS INTEGER) AS branch_num,\n  CAST(branch_code AS VARCHAR) AS branch_code,\n  CAST(branch_name AS VARCHAR) AS branch_name,\n  CAST(item_num AS BIGINT) AS item_num,\n  CAST(item_code AS VARCHAR) AS item_code,\n  CAST(item_barcode AS VARCHAR) AS item_barcode,\n  CAST(item_name AS VARCHAR) AS item_name,\n  CAST(item_spec AS VARCHAR) AS item_spec,\n  CAST(item_unit AS VARCHAR) AS item_unit,\n  CAST(movement_type AS VARCHAR) AS movement_type,\n  CAST(movement_summary AS VARCHAR) AS movement_summary,\n  CAST(movement_date AS DATE) AS movement_date,\n  CAST(operate_time AS TIMESTAMP) AS operate_time,\n  CAST(operator AS VARCHAR) AS operator,\n  CAST(bill_no AS VARCHAR) AS bill_no,\n  CAST(lot_number AS VARCHAR) AS lot_number,\n  CAST(memo AS VARCHAR) AS memo,\n  CAST(quantity AS DECIMAL(18,6)) AS quantity,\n  CAST(assist_quantity AS DECIMAL(18,6)) AS assist_quantity,\n  CAST(unit_price AS DECIMAL(18,8)) AS unit_price,\n  CAST(money AS DECIMAL(18,2)) AS money,\n  CAST(inventory_balance AS DECIMAL(18,6)) AS inventory_balance,\n  CAST(assist_inventory_balance AS DECIMAL(18,6)) AS assist_inventory_balance,\n  CAST(out_storehouse_num AS BIGINT) AS out_storehouse_num,\n  CAST(out_storehouse_code AS VARCHAR) AS out_storehouse_code,\n  CAST(out_storehouse_name AS VARCHAR) AS out_storehouse_name,\n  CAST(computed_at AS TIMESTAMPTZ) AS computed_at\nFROM input o\n"
        }
      }
    },
    {
      "id": "gate",
