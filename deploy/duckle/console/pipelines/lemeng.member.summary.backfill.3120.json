        "properties": {
          "sql": "SELECT\n  'ms-' || '${ENV:SYSTEM_BOOK}' || '-member_summary-' || replace(replace('${datetime}','-',''),'_','T') || 'Z' AS batch_id,\n  '${ENV:SYSTEM_BOOK}' AS system_book,\n  CAST('${date-1d}' AS DATE) AS bizday,\n  CAST(o.order_sale_type AS INTEGER) AS order_sale_type,\n  CAST(o.order_sale_type_name AS VARCHAR) AS order_sale_type_name,\n  CAST(o.receive_money AS DECIMAL(14,2)) AS receive_money,\n  CAST(o.receipt_coupon_share_money AS DECIMAL(14,2)) AS receipt_coupon_share_money,\n  CAST(o.customer_nums AS BIGINT) AS customer_nums,\n  CAST(o.customer_ave_price_no_coupon AS DECIMAL(14,2)) AS customer_ave_price_no_coupon,\n  CAST(o.customer_ave_price AS DECIMAL(14,2)) AS customer_ave_price,\n  CAST(o.customer_vip_money AS DECIMAL(14,2)) AS customer_vip_money,\n  CAST(o.customer_vip_nums AS BIGINT) AS customer_vip_nums,\n  CAST(o.customer_vip_ave_price AS DECIMAL(14,2)) AS customer_vip_ave_price,\n  CAST(o.member_customer_price AS DECIMAL(14,2)) AS member_customer_price,\n  CAST(o.relat_rate AS DECIMAL(18,8)) AS relat_rate,\n  CAST(o.relat_rate_vip AS DECIMAL(18,8)) AS relat_rate_vip,\n  CAST(o.buy_rate AS DECIMAL(18,8)) AS buy_rate,\n  CAST(o.item_sale_cost AS DECIMAL(14,2)) AS item_sale_cost,\n  CAST(o.item_sale_profit AS DECIMAL(14,2)) AS item_sale_profit,\n  CAST(o.item_sale_profit_rate AS DECIMAL(18,8)) AS item_sale_profit_rate,\n  CAST(92 AS INTEGER) AS branch_num,\n  CAST('沾益02' AS VARCHAR) AS branch_code,\n  CAST('熊喵曲靖沾益2店' AS VARCHAR) AS branch_name\nFROM input o"
        }
