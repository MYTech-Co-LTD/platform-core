      "data": {
        "label": "shape",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT\n  'pu-' || '${ENV:SYSTEM_BOOK}' || '-item_purchase-' || replace(replace('${datetime}','-',''),'_','T') || 'Z' AS batch_id,\n  '${ENV:SYSTEM_BOOK}' AS system_book,\n  CAST('${date-1d}' AS DATE) AS bizday,\n  CAST(o.supplier_num AS BIGINT) AS supplier_num,\n  CAST(o.supplier_code AS VARCHAR) AS supplier_code,\n  CAST(o.supplier_name AS VARCHAR) AS supplier_name,\n  CAST(o.item_num AS BIGINT) AS item_num,\n  CAST(o.item_code AS VARCHAR) AS item_code,\n  CAST(o.item_barcode AS VARCHAR) AS item_barcode,\n  CAST(o.item_name AS VARCHAR) AS item_name,\n  CAST(o.item_spec AS VARCHAR) AS item_spec,\n  CAST(o.base_unit AS VARCHAR) AS base_unit,\n  CAST(o.purchase_item_amount AS DECIMAL(14,6)) AS purchase_item_amount,\n  CAST(o.purchase_item_money AS DECIMAL(14,2)) AS purchase_item_money,\n  CAST(o.purchase_present_amount AS DECIMAL(14,6)) AS purchase_present_amount,\n  CAST(o.purchase_present_money AS DECIMAL(14,2)) AS purchase_present_money,\n  CAST(o.purchase_item_return_amount AS DECIMAL(14,6)) AS purchase_item_return_amount,\n  CAST(o.purchase_item_return_money AS DECIMAL(14,2)) AS purchase_item_return_money,\n  CAST(o.amount_total AS DECIMAL(14,6)) AS amount_total,\n  CAST(o.money_total AS DECIMAL(14,2)) AS money_total\nFROM input, UNNEST(input.\"rows\") AS t(o)\nWHERE (SELECT CASE WHEN (SELECT count(*) FROM (SELECT UNNEST(input.\"rows\") FROM input))\n                          <> (SELECT any_value(total_count) FROM input)\n                    THEN error('ITEM_PURCHASE_ROWS_MISMATCH: len(rows) <> total_count（截断守卫，#640）')\n                    ELSE 0 END) IS NOT NULL"
        }
      }
    },
