    {
      "id": "flatten",
      "type": "transform",
      "position": {
        "x": 780,
        "y": 420
      },
      "data": {
        "label": "UNNEST pos_order_details + 定型到契约列",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT\n  '${ITER_ITEM_BATCH_ID}' AS batch_id,\n  '${ITER_ITEM_SYSTEM_BOOK}' AS system_book,\n  CAST(strptime(json_extract_string(u.d, '$.order_detail_bizday'), '%Y%m%d') AS DATE) AS bizday,\n  CAST(date_part('hour', CAST(o.order_time AS TIMESTAMP)) AS INTEGER) AS hour,\n  CAST(o.order_no AS VARCHAR) AS order_no,\n  CAST(json_extract_string(u.d, '$.order_detail_num') AS VARCHAR) AS order_detail_num,\n  CAST(json_extract_string(u.d, '$.branch_num') AS INTEGER) AS branch_num,\n  json_extract_string(CAST(o.branch AS JSON), '$.branch_name') AS branch_name,\n  CAST(o.order_time AS TIMESTAMP) AS order_time,\n  CAST(o.order_operate_time AS TIMESTAMP) AS order_operate_time,\n  CAST(o.state AS VARCHAR) AS state,\n  CAST(o.order_source AS VARCHAR) AS order_source,\n  CAST(json_extract_string(u.d, '$.item_num') AS VARCHAR) AS item_num,\n  json_extract_string(u.d, '$.item_code') AS item_code,\n  CAST(json_extract_string(u.d, '$.order_detail_money') AS DECIMAL(14,2)) AS sale_money,\n  CAST(json_extract_string(u.d, '$.order_detail_discount') AS DECIMAL(14,2)) AS discount_money,\n  CAST(json_extract_string(u.d, '$.order_detail_payment_money') AS DECIMAL(14,2)) AS payment_money,\n  CAST(json_extract_string(u.d, '$.order_detail_amount') AS DECIMAL(14,3)) AS quantity,\n  CAST(o.order_transaction_type AS VARCHAR) AS order_transaction_type,\n  CAST(o.order_ref_billno AS VARCHAR) AS order_ref_billno,\n  CAST(json_extract_string(u.d, '$.order_detail_share_discount') AS DECIMAL(14,2)) AS order_detail_share_discount,\n  CAST(json_extract_string(u.d, '$.order_detail_std_price') AS DECIMAL(14,2)) AS order_detail_std_price,\n  CAST(json_extract_string(u.d, '$.order_detail_price') AS DECIMAL(14,2)) AS order_detail_price,\n  CAST(json_extract_string(u.d, '$.order_detail_online_qty') AS DECIMAL(14,3)) AS order_detail_online_qty,\n  CAST(o.order_total_money AS DECIMAL(14,2)) AS order_total_money\nFROM input o\nCROSS JOIN UNNEST(from_json(CAST(o.pos_order_details AS JSON), '[\"JSON\"]')) AS u(d)"
        }
      }
