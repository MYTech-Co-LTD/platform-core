      },
      "data": {
        "label": "whoami 身份探针（xml + raw 落原件）",
        "componentId": "src.rest",
        "properties": {
          "connectionRef": "lemeng",
          "url": "https://cloud.nhsoft.cn/agi/mcp",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
          },
          "body": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"whoami\", \"arguments\": {}}}",
          "paginationType": "none",
          "responseFormat": "xml",
          "rawResponseDestination": "/workspace/.duckle-raw/whoami-${ENV:BATCH_ID}.sse",
          "retryAttempts": 3,
          "retryBackoffMs": 2000
        },
        "schema": [
          {
            "name": "x",
            "type": "string"
          }
        ]
      }
    },
    {
      "id": "g0",
      "type": "transform",
      "position": {
        "x": 240,
        "y": -600
      },
      "data": {
        "label": "抠出全部 SSE data: 行",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT unnest(regexp_extract_all(content, '(?m)^data: ([^\\r\\n]*)', 1)) AS line FROM read_text('/workspace/.duckle-raw/whoami-${ENV:BATCH_ID}.sse')"
        }
      }
    },
    {
      "id": "g1",
      "type": "transform",
      "position": {
        "x": 480,
        "y": -600
      },
      "data": {
        "label": "取最后一条 + 拆 JSON-RPC 外壳（对齐 wrapper 的 m[-1]）",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT json_extract_string(line, '$.result.content[0].text') AS txt FROM input QUALIFY row_number() OVER () = count(*) OVER ()"
        }
      }
    },
    {
      "id": "g2",
      "type": "transform",
      "position": {
        "x": 720,
        "y": -600
      },
      "data": {
        "label": "取身份事实 company_id / branch_nums",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT json_extract_string(txt, '$.company_id') AS company_id, json_extract_string(txt, '$.branch_nums') AS branch_nums FROM input"
        }
      }
    },
    {
      "id": "d0",
      "type": "control",
      "position": {
        "x": 960,
        "y": -600
      },
      "data": {
        "label": "反向闸：抠不出身份 ⇒ 红（挡网关形状漂移）",
        "componentId": "ctl.die",
        "properties": {
          "condition": "no-rows",
          "message": "identity: whoami 响应里没有可解析的身份（网关形状变了？）⇒ 身份未证，拒绝采集与写湖"
        }
      }
    },
    {
      "id": "g3",
      "type": "transform",
      "position": {
        "x": 1200,
        "y": -600
      },
      "data": {
        "label": "两条断言：① 账套 ② 配置门店 ⊆ 可见门店",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT 'book' AS violation, company_id AS detail FROM input WHERE company_id IS DISTINCT FROM '${ENV:SYSTEM_BOOK}' UNION ALL SELECT 'branch' AS violation, CAST(c.branch_num AS VARCHAR) AS detail FROM (SELECT unnest('${ENV:BRANCH_NUMS}'::BIGINT[]) AS branch_num) c LEFT JOIN (SELECT unnest(CAST(json_extract(branch_nums, '$[*]') AS BIGINT[])) AS branch_num FROM input) w USING (branch_num) WHERE w.branch_num IS NULL"
        }
      }
    },
    {
      "id": "d1",
      "type": "control",
      "position": {
        "x": 1440,
        "y": -600
      },
      "data": {
        "label": "有违规行 ⇒ 红；其后才 trigger 采集（先证后采）",
        "componentId": "ctl.die",
        "properties": {
          "condition": "has-rows",
          "message": "identity: 凭据账套/门店清单自证未过 ⇒ 拒绝采集与写湖"
        }
      }
    },
