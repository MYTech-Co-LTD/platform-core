          }
        ]
      }
    },
    {
      "id": "guard",
      "type": "transform",
      "position": {
        "x": 260,
        "y": 480
      },
      "data": {
        "label": "last-page guard (capacity truncation)",
        "componentId": "ctl.die",
        "properties": {
          "condition": "has-rows",
          "message": "lemeng dim_branch 容量截断：第 5 页（哨兵页）仍有 {rows} 行（system_book=${ENV:SYSTEM_BOOK}）⇒ 门店数已击穿真阈值 800 家（算式：真阈值 = 非哨兵页数 4 × page_size 200 = 800，哨兵页那一页不计容量；口径同 spec §6 的 200×12 页 ⇒ 阈值 11×200 = 2200，不是 2400）。处置：加数据页节点 → 同步改本算式与 p5 的 page_number → 重生成 data-plane lock → 走 PR"
        }
      }
    },
    {
      "id": "merge",
      "type": "transform",
      "position": {
        "x": 520,
        "y": 420
      },
      "data": {
        "label": "merge pages 1-5",
        "componentId": "ctl.merge",
        "properties": {}
      }
    },
    {
      "id": "shape",
      "type": "transform",
      "position": {
        "x": 780,
        "y": 420
      },
      "data": {
        "label": "注入 batch_id/system_book/snapshot + 定型到契约列",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT\n  'dim-' || '${ENV:SYSTEM_BOOK}' || '-branch-' || replace(replace('${datetime}','-',''),'_','T') || 'Z' AS batch_id,\n  '${ENV:SYSTEM_BOOK}' AS system_book,\n  CAST('${date+8h}' AS DATE) AS snapshot,\n  CAST(o.branch_num AS INTEGER) AS branch_num,\n  CAST(o.code AS VARCHAR) AS code,\n  CAST(o.name AS VARCHAR) AS name,\n  CAST(o.pinyin AS VARCHAR) AS pinyin,\n  CAST(o.type AS VARCHAR) AS type,\n  CAST(o.enable AS BOOLEAN) AS enable,\n  CAST(o.region_id AS INTEGER) AS region_id,\n  CAST(o.province AS VARCHAR) AS province,\n  CAST(o.city AS VARCHAR) AS city,\n  CAST(o.district AS VARCHAR) AS district,\n  CAST(o.contact AS VARCHAR) AS contact,\n  CAST(o.phone AS VARCHAR) AS phone,\n  CAST(o.address AS VARCHAR) AS address\nFROM input o"
        }
      }
    },
    {
      "id": "gate",
      "type": "transform",
      "position": {
        "x": 1040,
        "y": 420
      },
      "data": {
        "label": "contract gate",
        "componentId": "qa.contract",
        "properties": {
          "rules": {
            "batch_id": "not_null",
            "system_book": "not_null",
            "snapshot": "not_null",
            "branch_num": "not_null"
          }
        }
      }
    },
    {
      "id": "sink",
      "type": "sink",
      "position": {
        "x": 1300,
        "y": 420
      },
      "data": {
        "label": "dim_branch all.parquet",
        "componentId": "snk.minio",
        "properties": {
          "connectionRef": "zos",
          "bucket": "${ENV:ZOS_BUCKET}",
          "key": "lemeng/dim_branch/system_book=${ENV:SYSTEM_BOOK}/snapshot=${date+8h}/all.parquet",
          "region": "${ENV:ZOS_REGION}",
          "urlStyle": "path",
          "useSsl": "true",
          "format": "parquet",
          "mode": "overwrite",
          "compression": "zstd"
        }
      }
    },
    {
      "id": "gv",
      "type": "control",
      "position": {
        "x": 1680,
        "y": -600
      },
      "data": {
        "label": "Assert expected-value shapes",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT 'BRANCH_NUMS' AS violation, '${ENV:BRANCH_NUMS}' AS detail, 'JSON integer array, e.g. [1001,1002]' AS rule\nWHERE NOT regexp_full_match('${ENV:BRANCH_NUMS}', '\\[[0-9]+([, ]+[0-9]+)*\\]')\nUNION ALL SELECT 'SYSTEM_BOOK', '${ENV:SYSTEM_BOOK}', 'digits only'\nWHERE NOT regexp_full_match('${ENV:SYSTEM_BOOK}', '[0-9]{1,32}')\nUNION ALL SELECT 'SNAPSHOT', '${date+8h}', 'YYYY-MM-DD'\nWHERE NOT regexp_full_match('${date+8h}', '[0-9]{4}-[0-9]{2}-[0-9]{2}')\nUNION ALL SELECT 'BATCH_ID', 'dim-' || '${ENV:SYSTEM_BOOK}' || '-branch-' || replace(replace('${datetime}','-',''),'_','T') || 'Z' AS v, 'dim-<book>-branch-YYYYMMDDTHHMMSSZ'\nWHERE NOT regexp_full_match('dim-' || '${ENV:SYSTEM_BOOK}' || '-branch-' || replace(replace('${datetime}','-',''),'_','T') || 'Z', 'dim-[0-9]+-branch-[0-9]{8}T[0-9]{6}Z')"
        }
      }
    },
    {
      "id": "dv",
      "type": "control",
      "position": {
        "x": 1920,
        "y": -600
      },
      "data": {
        "label": "Die on missing/malformed expected values",
        "componentId": "ctl.die",
        "properties": {
          "condition": "has-rows",
          "message": "EXPECTED_VALUE_MISSING_OR_MALFORMED: 期望值缺席或形状非法（{rows} 条违规，明细见上）⇒ 拒绝采集与写湖（等价于 wrapper 在 run-retail-day.sh:383/397 的 ASSERT_FAIL 硬失败）。处置：检查该管线调度/触发面的 env 注入"
        }
      }
    },
    {
      "id": "a1",
      "type": "control",
      "position": {
        "x": 1620,
        "y": 420
      },
      "data": {
        "label": "先落湖后报（_ops 定序锚）",
        "componentId": "ctl.anchor",
        "properties": {}
      }
    },
    {
      "id": "op",
      "type": "transform",
      "position": {
        "x": 1860,
        "y": 420
      },
      "data": {
        "label": "_ops 行成形（job=dim-branch；自读 gate 计数，不读 input——同 gv 先例）",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT strftime(now(), '%Y-%m-%dT%H:%M:%SZ') AS ts, 'dim-branch' AS job, '${ENV:SYSTEM_BOOK}' AS system_book,\n  max(snapshot) AS snapshot, count(*) AS \"rows\", 'ok' AS status FROM \"gate\""
        }
      }
    },
    {
      "id": "wh",
      "type": "sink",
      "position": {
        "x": 2100,
        "y": 420
      },
      "data": {
        "label": "_ops 行投 OO retail_day（软 stage；方言同 #407 tick _note ⑩）",
        "componentId": "snk.webhook",
        "properties": {
          "url": "${ENV:OO_BASE}/api/${ENV:OO_ORG}/retail-day/_json",
          "method": "POST",
          "headers": {
            "Authorization": "Basic ${ENV:OO_AUTH}",
            "Content-Type": "application/json"
          },
          "batchMode": "one",
          "retryAttempts": 3,
          "retryBackoffMs": 2000,
          "continueOnFailure": true
        }
      }
    }
  ],
