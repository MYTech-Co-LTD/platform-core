      },
      "data": {
        "label": "w0",
        "componentId": "src.rest",
        "schema": [
          {
            "name": "x",
            "type": "string"
          }
        ],
        "properties": {
          "connectionRef": "lemeng",
          "url": "https://cloud.nhsoft.cn/agi/mcp",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
          },
          "body": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"whoami\", \"arguments\": {}}}",
          "paginationType": "none",
          "responseFormat": "xml",
          "rawResponseDestination": "/workspace/.duckle-raw/whoami-${datetime}.sse",
          "retryAttempts": 3,
          "retryBackoffMs": 2000
        }
      }
    },
    {
      "id": "g0",
      "type": "transform",
      "position": {
        "x": 300,
        "y": -400
      },
      "data": {
        "label": "g0",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT unnest(regexp_extract_all(content, '(?m)^data: ([^\\r\\n]*)', 1)) AS line FROM read_text('/workspace/.duckle-raw/whoami-${datetime}.sse')"
        }
      }
    },
    {
      "id": "g1",
      "type": "transform",
      "position": {
        "x": 600,
        "y": -400
      },
      "data": {
        "label": "g1",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT json_extract_string(line, '$.result.content[0].text') AS txt FROM input QUALIFY row_number() OVER () = count(*) OVER ()"
        }
      }
    },
    {
      "id": "g2",
      "type": "transform",
      "position": {
        "x": 900,
        "y": -400
      },
      "data": {
        "label": "g2",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT json_extract_string(txt, '$.company_id') AS company_id, json_extract_string(txt, '$.branch_nums') AS branch_nums FROM input"
        }
      }
    },
    {
      "id": "d0",
      "type": "transform",
      "position": {
        "x": 1200,
        "y": -400
      },
      "data": {
        "label": "d0",
        "componentId": "ctl.die",
        "properties": {
          "condition": "no-rows",
          "message": "identity: whoami 响应里没有可解析的身份（网关形状变了？）⇒ 身份未证，拒绝采集与写湖"
        }
      }
    },
    {
      "id": "g3",
      "type": "transform",
      "position": {
        "x": 1500,
        "y": -400
      },
      "data": {
        "label": "g3",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT 'book' AS violation, company_id AS detail FROM input WHERE company_id IS DISTINCT FROM '${ENV:SYSTEM_BOOK}' UNION ALL SELECT 'branch' AS violation, CAST(c.branch_num AS VARCHAR) AS detail FROM (SELECT unnest('${ENV:BRANCH_NUMS}'::BIGINT[]) AS branch_num) c LEFT JOIN (SELECT unnest(CAST(json_extract(branch_nums, '$[*]') AS BIGINT[])) AS branch_num FROM input) w USING (branch_num) WHERE w.branch_num IS NULL"
        }
      }
    },
    {
      "id": "d1",
      "type": "transform",
      "position": {
        "x": 1800,
        "y": -400
      },
      "data": {
        "label": "d1",
        "componentId": "ctl.die",
        "properties": {
          "condition": "has-rows",
          "message": "identity: 凭据账套/门店清单自证未过 ⇒ 拒绝采集与写湖"
        }
      }
    },
    {
      "id": "gv",
      "type": "transform",
      "position": {
        "x": 2100,
        "y": -400
      },
      "data": {
        "label": "gv",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT 'BRANCH_NUMS' AS violation, '${ENV:BRANCH_NUMS}' AS detail, 'JSON integer array, e.g. [1001,1002]' AS rule WHERE NOT regexp_full_match('${ENV:BRANCH_NUMS}', '\\[[0-9]+([, ]+[0-9]+)*\\]') UNION ALL SELECT 'SYSTEM_BOOK', '${ENV:SYSTEM_BOOK}', 'digits only' WHERE NOT regexp_full_match('${ENV:SYSTEM_BOOK}', '[0-9]{1,32}') UNION ALL SELECT 'BIZDAY', '${date+8h}', 'YYYY-MM-DD' WHERE NOT regexp_full_match('${date+8h}', '[0-9]{4}-[0-9]{2}-[0-9]{2}')"
        }
      }
    },
    {
