      "data": {
        "label": "shape",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT\n  'be-' || '${ENV:SYSTEM_BOOK}' || '-branch_expense-' || replace(replace('${datetime}','-',''),'_','T') || 'Z' AS batch_id,\n  '${ENV:SYSTEM_BOOK}' AS system_book,\n  CAST('${BIZDAY}' AS DATE) AS bizday,\n  CAST(o.bill_no AS VARCHAR) AS bill_no,\n  CAST(o.branch_num AS INTEGER) AS branch_num,\n  CAST(o.branch_name AS VARCHAR) AS branch_name,\n  CAST(o.branch_code AS VARCHAR) AS branch_code,\n  CAST(o.store_name AS VARCHAR) AS store_name,\n  CAST(o.operate_branch_num AS INTEGER) AS operate_branch_num,\n  CAST(o.operate_branch_name AS VARCHAR) AS operate_branch_name,\n  CAST(o.expense_type AS VARCHAR) AS expense_type,\n  CAST(o.direction AS VARCHAR) AS direction,\n  CAST(o.amount AS DECIMAL(14,2)) AS amount,\n  CAST(o.due_amount AS DECIMAL(14,2)) AS due_amount,\n  CAST(o.paid_amount AS DECIMAL(14,2)) AS paid_amount,\n  CAST(o.payment_date AS VARCHAR) AS payment_date,\n  CAST(o.tax_rate AS DECIMAL(18,8)) AS tax_rate,\n  CAST(o.tax_amount AS DECIMAL(14,2)) AS tax_amount,\n  CAST(o.audit_time AS VARCHAR) AS audit_time,\n  CAST(o.create_time AS VARCHAR) AS create_time,\n  CAST(o.reference_bill AS VARCHAR) AS reference_bill,\n  CAST(o.memo AS VARCHAR) AS memo,\n  CAST(o.settlement_state AS INTEGER) AS settlement_state,\n  CAST(o.settlement_state_name AS VARCHAR) AS settlement_state_name,\n  CAST(o.last_edit_time AS VARCHAR) AS last_edit_time\nFROM input o"
        }
      }
    },
