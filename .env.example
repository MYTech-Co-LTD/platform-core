PORT=13000
DATABASE_URL=postgres://platform:platform@127.0.0.1:5432/platform
TENANT_MODE=single
PLATFORM_ORG=acme
PLATFORM_SESSION_SECRET=change-me-at-least-32-bytes-secret
CASDOOR_URL=https://sso.example.test
CASDOOR_CLIENT_ID=platform
CASDOOR_CLIENT_SECRET=
CASDOOR_ADMIN_USER=
CASDOOR_ADMIN_PWD=
CASDOOR_APPLICATION=
PUBLIC_ORIGIN=http://127.0.0.1:13000
# SEED_DEMO=1  # dev：启动期种 acme/beta demo 租户（幂等；生产不设）

# 仅供本地长驻栈 `pnpm dev:stack`（scripts/dev-stack.mjs）读，宿主进程**不读**它。
# 该脚本自持全部 env（不读 .env），此键只用于换端口；默认 13100（避开 13000 = pnpm dev / compose 默认）。
# DEV_STACK_PORT=13100
