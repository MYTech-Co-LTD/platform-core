      "window": {
        "start": "09:00",
        "end": "01:59"
      },
      "sla": {
        "sourceToBuildMinutes": 10,
        "buildIntervalMinutes": 15,
        "missingOkMinutes": 20,
        "windowGraceMinutes": 20
      },
      "source": {
        "kind": "retail_hot_run_token"
      }
    },
    "nonretail_1h": {
