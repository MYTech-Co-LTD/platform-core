    { "name": "item_direct_rate",                       "type": "varchar", "nullable": true,            "description": "（两账套 200 行样本全 null ⇒ 无类型实测证据，按 varchar 声明，见契约 description 的类型口径）" },
    { "name": "item_en_name",                           "type": "varchar", "nullable": true,            "description": "（两账套 200 行样本全 null ⇒ 无类型实测证据，按 varchar 声明，见契约 description 的类型口径）" },
    { "name": "item_note_info",                         "type": "varchar", "nullable": true,            "description": "（两账套 200 行样本全 null ⇒ 无类型实测证据，按 varchar 声明，见契约 description 的类型口径）" },
