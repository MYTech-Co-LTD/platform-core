    { "name": "unit_group_name",                        "type": "varchar", "nullable": true },
    { "name": "tax_code",                               "type": "varchar", "nullable": true,            "description": "（两账套 200 行样本全 null ⇒ 无类型实测证据，按 varchar 声明，见契约 description 的类型口径）" },
    { "name": "valid_period",                           "type": "integer", "nullable": true },
    { "name": "made_in",                                "type": "varchar", "nullable": true },
    { "name": "eliminate_flag",                         "type": "boolean", "nullable": true },
    { "name": "eliminate_at",                           "type": "varchar", "nullable": true,            "description": "（两账套 200 行样本全 null ⇒ 无类型实测证据，按 varchar 声明，见契约 description 的类型口径）" },
    { "name": "eliminate_operator",                     "type": "varchar", "nullable": true,            "description": "（两账套 200 行样本全 null ⇒ 无类型实测证据，按 varchar 声明，见契约 description 的类型口径）" },
    { "name": "item_sale_cease_flag",                   "type": "boolean", "nullable": true },
    { "name": "description",                            "type": "varchar", "nullable": true,            "description": "（两账套 200 行样本全 null ⇒ 无类型实测证据，按 varchar 声明，见契约 description 的类型口径）" },
    { "name": "item_point_value",                       "type": "decimal", "precision": 18, "scale": 8, "nullable": true },
