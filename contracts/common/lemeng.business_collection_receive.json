{
  "$schema": "./_schema.schema.json",
  "contractVersion": 2,
  "schemaVersion": 1,
  "consumerVersion": 1,
  "domain": "lemeng",
  "table": "business_collection_receive",
  "owner": "data-platform",
  "description": "乐檬营业收款报表-门店收款构成日粒度（nhsoft.report.ai.businesscollection.receive.find；AMAREPORT，2026-11-06 接源）。【行粒度】一行 = 账套 × bizday × 门店 × 支付方式。【窗口】单日窗（date_start=date_end=BIZDAY），含首尾最多 31 天（10002）；`branch_nums` 必填且**单请求 ≤100 家**（10001，3120 有 270 家 ⇒ 父管线按 100 切块 ctl.foreach）；越权店号 10003。【省略语义】当日无数据的门店不出现在 rows 里（total_count == len(rows) 合法）⇒ 缺行 = 无数据，不是零值。【不分页】接口一次返回全部。接口始终按 payment_type 分组返回（即使未显式选该维）；order_types 固定请求全部七类业务类型。",
  "layout": {
    "prefix": "lemeng/business_collection_receive",
    "partitionStyle": "hive",
    "partitionBy": [
      "system_book",
      "bizday"
    ],
    "fileName": "all.parquet"
  },
  "batch": {
    "markerColumn": "batch_id",
    "type": "varchar",
    "unique": false,
    "note": "= 父管线 lemeng.business_collection_receive.l0.<book> 每轮的批次号（UTC 时间戳串）。同一 bizday 分区每轮覆盖写；回填变体 lemeng.business_collection_receive.backfill.<book> 由 params.BIZDAY 驱动、复用同一 layout。"
  },
  "columns": [
    {
      "name": "batch_id",
      "type": "varchar",
      "nullable": false,
      "description": "采集批次（父管线 drv 的 batch_id，UTC 时间戳串）",
      "expr": "CAST(batch_id AS VARCHAR)"
    },
    {
      "name": "system_book",
      "type": "integer",
      "nullable": false,
      "description": "账套（3120 熊喵 / 64188 品品甜）；分区键",
      "expr": "CAST(system_book AS INTEGER)"
    },
    {
      "name": "bizday",
      "type": "date",
      "nullable": false,
      "description": "营业日（查询窗单日）；分区键",
      "expr": "CAST(bizday AS DATE)"
    },
    {
      "name": "branch_num",
      "type": "integer",
      "nullable": false,
      "description": "门店编号",
      "expr": "CAST(branch_num AS INTEGER)"
    },
    {
      "name": "branch_code",
      "type": "varchar",
      "nullable": true,
      "description": "门店编码",
      "expr": "CAST(branch_code AS VARCHAR)"
    },
    {
      "name": "branch_name",
      "type": "varchar",
      "nullable": true,
      "description": "门店名称",
      "expr": "CAST(branch_name AS VARCHAR)"
    },
    {
      "name": "payment_type",
      "type": "varchar",
      "nullable": true,
      "description": "支付方式名称",
      "expr": "CAST(payment_type AS VARCHAR)"
    },
    {
      "name": "receive_money",
      "type": "decimal(20,2)",
      "nullable": true,
      "description": "收款金额（元）",
      "expr": "CAST(receive_money AS DECIMAL(20, 2))"
    },
    {
      "name": "receive_money_rate",
      "type": "decimal(20,6)",
      "nullable": true,
      "description": "收款金额占比（占比，0–1 小数）",
      "expr": "CAST(receive_money_rate AS DECIMAL(20, 6))"
    },
    {
      "name": "order_count",
      "type": "integer",
      "nullable": true,
      "description": "收款笔数",
      "expr": "CAST(order_count AS INTEGER)"
    },
    {
      "name": "order_count_rate",
      "type": "decimal(20,6)",
      "nullable": true,
      "description": "笔数占比（占比，0–1 小数）",
      "expr": "CAST(order_count_rate AS DECIMAL(20, 6))"
    },
    {
      "name": "pos_order_receive_money",
      "type": "decimal(20,2)",
      "nullable": true,
      "description": "已结账单收款金额（元）",
      "expr": "CAST(pos_order_receive_money AS DECIMAL(20, 2))"
    },
    {
      "name": "pos_order_count",
      "type": "integer",
      "nullable": true,
      "description": "已结账单笔数",
      "expr": "CAST(pos_order_count AS INTEGER)"
    },
    {
      "name": "card_deposit_receive_money",
      "type": "decimal(20,2)",
      "nullable": true,
      "description": "卡存款收款金额（元）",
      "expr": "CAST(card_deposit_receive_money AS DECIMAL(20, 2))"
    },
    {
      "name": "card_deposit_order_count",
      "type": "integer",
      "nullable": true,
      "description": "卡存款笔数",
      "expr": "CAST(card_deposit_order_count AS INTEGER)"
    },
    {
      "name": "card_relate_receive_money",
      "type": "decimal(20,2)",
      "nullable": true,
      "description": "会员续卡收款金额（元）",
      "expr": "CAST(card_relate_receive_money AS DECIMAL(20, 2))"
    },
    {
      "name": "card_relate_order_count",
      "type": "integer",
      "nullable": true,
      "description": "会员续卡笔数",
      "expr": "CAST(card_relate_order_count AS INTEGER)"
    },
    {
      "name": "card_replace_receive_money",
      "type": "decimal(20,2)",
      "nullable": true,
      "description": "会员换卡收款金额（元）",
      "expr": "CAST(card_replace_receive_money AS DECIMAL(20, 2))"
    },
    {
      "name": "card_replace_order_count",
      "type": "integer",
      "nullable": true,
      "description": "会员换卡笔数",
      "expr": "CAST(card_replace_order_count AS INTEGER)"
    },
    {
      "name": "exchange_card_receive_money",
      "type": "decimal(20,2)",
      "nullable": true,
      "description": "次卡收款金额（元）",
      "expr": "CAST(exchange_card_receive_money AS DECIMAL(20, 2))"
    },
    {
      "name": "exchange_card_order_count",
      "type": "integer",
      "nullable": true,
      "description": "次卡笔数",
      "expr": "CAST(exchange_card_order_count AS INTEGER)"
    },
    {
      "name": "other_receive_money",
      "type": "decimal(20,2)",
      "nullable": true,
      "description": "其他收支收款金额（元）",
      "expr": "CAST(other_receive_money AS DECIMAL(20, 2))"
    },
    {
      "name": "other_order_count",
      "type": "integer",
      "nullable": true,
      "description": "其他收支笔数",
      "expr": "CAST(other_order_count AS INTEGER)"
    },
    {
      "name": "purchase_records_receive_money",
      "type": "decimal(20,2)",
      "nullable": true,
      "description": "付费会员收款金额（元）",
      "expr": "CAST(purchase_records_receive_money AS DECIMAL(20, 2))"
    },
    {
      "name": "purchase_records_order_count",
      "type": "integer",
      "nullable": true,
      "description": "付费会员笔数",
      "expr": "CAST(purchase_records_order_count AS INTEGER)"
    },
    {
      "name": "computed_at",
      "type": "timestamp_tz",
      "nullable": false,
      "description": "采集写入时刻",
      "expr": "CAST(computed_at AS TIMESTAMPTZ)"
    }
  ]
}
