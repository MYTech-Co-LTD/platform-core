{
  "$schema": "./_schema.schema.json",
  "contractVersion": 2,
  "schemaVersion": 1,
  "consumerVersion": 1,
  "domain": "lemeng",
  "table": "item_sales",
  "owner": "data-platform",
  "description": "乐檬商品销售分析日粒度（nhsoft.report.ai.itemsales.find；AMAREPORT，2026-11-02 接源）。【行粒度】一行 = 账套×bizday×门店×商品（summary_types=[branch,item]）。【窗口】bizday_start=bizday_end 单日；网关硬限：含首尾最多 31 天（10002）、branch_nums 必填 ≤100 家（10001）、越权店号 10003。【省略语义】当日无销售的门店/商品不出现在 rows 里 ⇒ 缺行 = 无数据，不是零值。【与 item_profit 的关系】两表同粒度但商品集合不保证一致（实测同日同店各 59 行、首行商品不同）⇒ join 属 dbt 消费面，湖层不合表。【首发锚】3120 店 1 2026-10-28：sale_count=232 / sale_num=357.26 / sale_money=5505.0 / item_price=15.4089 / discount_money=1945.28。",
  "layout": {
    "prefix": "lemeng/item_sales",
    "partitionStyle": "hive",
    "partitionBy": [
      "system_book",
      "bizday"
    ],
    "fileName": "all.parquet"
  },
  "batch": {
    "markerColumn": "batch_id",
    "type": "varchar",
    "unique": false,
    "note": "= 父管线 lemeng.item_sales.l0.<book> 每轮的批次号（UTC 时间戳串）。同一 bizday 分区每轮覆盖写；回填变体由 params.BIZDAY 驱动、复用同一 layout。"
  },
  "columns": [
    {
      "name": "batch_id",
      "type": "varchar",
      "nullable": false,
      "description": "采集批次（父管线 drv 的 batch_id，UTC 时间戳串）",
      "expr": "CAST(batch_id AS VARCHAR)"
    },
    {
      "name": "system_book",
      "type": "integer",
      "nullable": false,
      "description": "账套（3120 熊喵 / 64188 品品甜）；分区键",
      "expr": "CAST(system_book AS INTEGER)"
    },
    {
      "name": "bizday",
      "type": "date",
      "nullable": false,
      "description": "营业日（查询窗单日 = bizday_start = bizday_end）；分区键",
      "expr": "CAST(bizday AS DATE)"
    },
    {
      "name": "branch_num",
      "type": "integer",
      "nullable": false,
      "description": "门店编号（与 dim_branch.branch_num 同键）",
      "expr": "CAST(branch_num AS INTEGER)"
    },
    {
      "name": "branch_code",
      "type": "varchar",
      "nullable": true,
      "description": "门店编码",
      "expr": "CAST(branch_code AS VARCHAR)"
    },
    {
      "name": "branch_name",
      "type": "varchar",
      "nullable": true,
      "description": "门店名称",
      "expr": "CAST(branch_name AS VARCHAR)"
    },
    {
      "name": "item_num",
      "type": "integer",
      "nullable": false,
      "description": "商品编号（与 dim_item.item_num 同键）",
      "expr": "CAST(item_num AS INTEGER)"
    },
    {
      "name": "item_code",
      "type": "varchar",
      "nullable": true,
      "description": "商品编码",
      "expr": "CAST(item_code AS VARCHAR)"
    },
    {
      "name": "item_name",
      "type": "varchar",
      "nullable": true,
      "description": "商品名称",
      "expr": "CAST(item_name AS VARCHAR)"
    },
    {
      "name": "spec",
      "type": "varchar",
      "nullable": true,
      "description": "规格（itemsales 侧字段名是 spec，与 item_profit 的 item_spec 同义）",
      "expr": "CAST(spec AS VARCHAR)"
    },
    {
      "name": "unit",
      "type": "varchar",
      "nullable": true,
      "description": "单位（itemsales 侧字段名是 unit，与 item_profit 的 item_unit 同义）",
      "expr": "CAST(unit AS VARCHAR)"
    },
    {
      "name": "sale_count",
      "type": "decimal", "precision": 20, "scale": 4,
      "nullable": true,
      "description": "销售次数（源：sale_count）",
      "expr": "CAST(sale_count AS DECIMAL(20,4))"
    },
    {
      "name": "sale_num",
      "type": "decimal", "precision": 20, "scale": 4,
      "nullable": false,
      "description": "商品销售数量（基本单位）",
      "expr": "CAST(sale_num AS DECIMAL(20,4))"
    },
    {
      "name": "total_num",
      "type": "decimal", "precision": 20, "scale": 4,
      "nullable": true,
      "description": "商品销售数量（含退货口径，源口径见文档）",
      "expr": "CAST(total_num AS DECIMAL(20,4))"
    },
    {
      "name": "sale_money",
      "type": "decimal", "precision": 20, "scale": 2,
      "nullable": true,
      "description": "销售金额",
      "expr": "CAST(sale_money AS DECIMAL(20,2))"
    },
    {
      "name": "item_price",
      "type": "decimal", "precision": 20, "scale": 6,
      "nullable": true,
      "description": "销售均价",
      "expr": "CAST(item_price AS DECIMAL(20,6))"
    },
    {
      "name": "return_num",
      "type": "decimal", "precision": 20, "scale": 4,
      "nullable": true,
      "description": "退货数量",
      "expr": "CAST(return_num AS DECIMAL(20,4))"
    },
    {
      "name": "return_money",
      "type": "decimal", "precision": 20, "scale": 2,
      "nullable": true,
      "description": "退货金额",
      "expr": "CAST(return_money AS DECIMAL(20,2))"
    },
    {
      "name": "present_num",
      "type": "decimal", "precision": 20, "scale": 4,
      "nullable": true,
      "description": "赠品数量",
      "expr": "CAST(present_num AS DECIMAL(20,4))"
    },
    {
      "name": "discount_money",
      "type": "decimal", "precision": 20, "scale": 2,
      "nullable": true,
      "description": "折扣金额",
      "expr": "CAST(discount_money AS DECIMAL(20,2))"
    },
    {
      "name": "order_detail_share_discount",
      "type": "decimal", "precision": 20, "scale": 2,
      "nullable": true,
      "description": "订单明细分摊金额",
      "expr": "CAST(order_detail_share_discount AS DECIMAL(20,2))"
    },
    {
      "name": "computed_at",
      "type": "timestamptz",
      "nullable": false,
      "description": "计算时间（子管线写 staging 时）",
      "expr": "CAST(computed_at AS TIMESTAMPTZ)"
    }
  ]
}
