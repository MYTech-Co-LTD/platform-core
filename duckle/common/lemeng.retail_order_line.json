      },
      "data": {
        "label": "last-page guard (capacity truncation)",
        "componentId": "ctl.die",
        "properties": {
          "condition": "has-rows",
          "message": "lemeng retail_order_line 容量截断：第 8 页仍有 {rows} 行（system_book=${ENV:SYSTEM_BOOK} bizday=${ENV:BIZDAY} hour=${ENV:HOUR} ${ENV:HOUR_FROM}~${ENV:HOUR_TO}）——缩小窗口或提高页容量后重跑"
        }
