    },
    {
      "id": "merge",
      "type": "transform",
      "position": {
        "x": 520,
        "y": 420
      },
      "data": {
        "label": "merge pages 1-8",
        "componentId": "ctl.merge",
        "properties": {}
      }
    },
    {
      "id": "flatten",
      "type": "transform",
      "position": {
        "x": 780,
        "y": 420
      },
      "data": {
        "label": "UNNEST pos_order_details + 定型到契约列",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT\n  '${ENV:BATCH_ID}' AS batch_id,\n  '${ENV:SYSTEM_BOOK}' AS system_book,\n  CAST(strptime(json_extract_string(u.d, '$.order_detail_bizday'), '%Y%m%d') AS DATE) AS bizday,\n  CAST(date_part('hour', CAST(o.order_time AS TIMESTAMP)) AS INTEGER) AS hour,\n  CAST(o.order_no AS VARCHAR) AS order_no,\n  CAST(json_extract_string(u.d, '$.order_detail_num') AS VARCHAR) AS order_detail_num,\n  CAST(json_extract_string(u.d, '$.branch_num') AS INTEGER) AS branch_num,\n  json_extract_string(CAST(o.branch AS JSON), '$.branch_name') AS branch_name,\n  CAST(o.order_time AS TIMESTAMP) AS order_time,\n  CAST(o.order_operate_time AS TIMESTAMP) AS order_operate_time,\n  CAST(o.state AS VARCHAR) AS state,\n  CAST(o.order_source AS VARCHAR) AS order_source,\n  CAST(json_extract_string(u.d, '$.item_num') AS VARCHAR) AS item_num,\n  json_extract_string(u.d, '$.item_code') AS item_code,\n  CAST(json_extract_string(u.d, '$.order_detail_money') AS DECIMAL(14,2)) AS sale_money,\n  CAST(json_extract_string(u.d, '$.order_detail_discount') AS DECIMAL(14,2)) AS discount_money,\n  CAST(json_extract_string(u.d, '$.order_detail_payment_money') AS DECIMAL(14,2)) AS payment_money,\n  CAST(json_extract_string(u.d, '$.order_detail_amount') AS DECIMAL(14,3)) AS quantity\nFROM input o\nCROSS JOIN UNNEST(from_json(CAST(o.pos_order_details AS JSON), '[\"JSON\"]')) AS u(d)"
        }
      }
    },
    {
      "id": "gate",
      "type": "transform",
      "position": {
        "x": 1040,
        "y": 420
      },
      "data": {
        "label": "contract gate",
        "componentId": "qa.contract",
        "properties": {
          "rules": {
            "order_no": "not_null",
            "order_detail_num": "not_null",
            "system_book": "not_null",
            "bizday": "not_null",
            "hour": "not_null",
            "batch_id": "not_null",
            "sale_money": "in_range:-1000000,1000000"
          }
        }
      }
    },
    {
      "id": "sink",
      "type": "sink",
      "position": {
        "x": 1300,
        "y": 420
      },
      "data": {
        "label": "retail_order_line all.parquet",
        "componentId": "snk.minio",
        "properties": {
          "bucket": "${ENV:ZOS_BUCKET}",
          "key": "lemeng/retail_order_line/system_book=${ENV:SYSTEM_BOOK}/bizday=${ENV:BIZDAY}/hour=${ENV:HOUR}/all.parquet",
          "endpoint": "${ENV:ZOS_ENDPOINT}",
          "region": "${ENV:ZOS_REGION}",
          "urlStyle": "path",
          "useSsl": "true",
          "accessKey": "${ENV:ZOS_ACCESS_KEY}",
          "secretKey": "${ENV:ZOS_SECRET_KEY}",
          "format": "parquet",
          "mode": "overwrite",
          "compression": "zstd"
        }
      }
    }
