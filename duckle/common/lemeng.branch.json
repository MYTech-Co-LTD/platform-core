    {
      "id": "guard",
      "type": "transform",
      "position": {
        "x": 260,
        "y": 480
      },
      "data": {
        "label": "last-page guard (capacity truncation)",
        "componentId": "ctl.die",
        "properties": {
          "condition": "has-rows",
          "message": "lemeng dim_branch 容量截断：第 5 页（哨兵页）仍有 {rows} 行（system_book=${ENV:SYSTEM_BOOK}）⇒ 门店数已击穿真阈值 800 家（算式：真阈值 = 非哨兵页数 4 × page_size 200 = 800，哨兵页那一页不计容量；口径同 spec §6 的 200×12 页 ⇒ 阈值 11×200 = 2200，不是 2400）。处置：加数据页节点 → 同步改本算式与 p5 的 page_number → 重生成 data-plane lock → 走 PR"
        }
      }
    },
    {
      "id": "merge",
      "type": "transform",
      "position": {
        "x": 520,
        "y": 420
      },
      "data": {
        "label": "merge pages 1-5",
        "componentId": "ctl.merge",
        "properties": {}
      }
    },
    {
      "id": "shape",
      "type": "transform",
      "position": {
        "x": 780,
        "y": 420
      },
      "data": {
        "label": "注入 batch_id/system_book/snapshot + 定型到契约列",
        "componentId": "code.sql",
        "properties": {
          "sql": "SELECT\n  '${ENV:BATCH_ID}' AS batch_id,\n  '${ENV:SYSTEM_BOOK}' AS system_book,\n  CAST('${ENV:SNAPSHOT}' AS DATE) AS snapshot,\n  CAST(o.branch_num AS INTEGER) AS branch_num,\n  CAST(o.code AS VARCHAR) AS code,\n  CAST(o.name AS VARCHAR) AS name,\n  CAST(o.pinyin AS VARCHAR) AS pinyin,\n  CAST(o.type AS VARCHAR) AS type,\n  CAST(o.enable AS BOOLEAN) AS enable,\n  CAST(o.region_id AS INTEGER) AS region_id,\n  CAST(o.province AS VARCHAR) AS province,\n  CAST(o.city AS VARCHAR) AS city,\n  CAST(o.district AS VARCHAR) AS district,\n  CAST(o.contact AS VARCHAR) AS contact,\n  CAST(o.phone AS VARCHAR) AS phone,\n  CAST(o.address AS VARCHAR) AS address\nFROM input o"
        }
      }
    },
    {
      "id": "gate",
      "type": "transform",
      "position": {
        "x": 1040,
        "y": 420
      },
      "data": {
        "label": "contract gate",
        "componentId": "qa.contract",
        "properties": {
          "rules": {
            "batch_id": "not_null",
            "system_book": "not_null",
            "snapshot": "not_null",
            "branch_num": "not_null"
          }
        }
      }
    },
    {
      "id": "sink",
      "type": "sink",
      "position": {
        "x": 1300,
        "y": 420
      },
      "data": {
        "label": "dim_branch all.parquet",
        "componentId": "snk.minio",
        "properties": {
          "bucket": "${ENV:ZOS_BUCKET}",
          "key": "lemeng/dim_branch/system_book=${ENV:SYSTEM_BOOK}/snapshot=${ENV:SNAPSHOT}/all.parquet",
          "endpoint": "${ENV:ZOS_ENDPOINT}",
          "region": "${ENV:ZOS_REGION}",
          "urlStyle": "path",
          "useSsl": "true",
          "accessKey": "${ENV:ZOS_ACCESS_KEY}",
          "secretKey": "${ENV:ZOS_SECRET_KEY}",
          "format": "parquet",
          "mode": "overwrite",
          "compression": "zstd"
        }
      }
    }
